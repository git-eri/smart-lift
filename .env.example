# LAN/VPN only. Change this to the server's LAN address to allow ESP/browser
# access. The Compose default remains loopback when no .env exists.
SMARTLIFT_BIND_ADDRESS=127.0.0.1
SMARTLIFT_PORT=8080
# Linux: match `id -u` and `id -g` for the owner of ./data.
SMARTLIFT_UID=1000
SMARTLIFT_GID=1000
# Optional controller/OTA authentication. Set the same controller_token in
# every ESP config.json. This does not authenticate human operators.
SMARTLIFT_CONTROLLER_TOKEN=
# Normally empty: browser WebSockets are limited to the current host.
# Comma-separated exact origins only when an additional trusted UI is needed.
SMARTLIFT_ALLOWED_ORIGINS=
TRAEFIK_LOG_LEVEL=INFO
